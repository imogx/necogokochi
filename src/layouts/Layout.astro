---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ねこごこち",
  description = "猫を触る前に、その子の気持ちを予習できるインタラクティブサイト",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/neco.png" />
  </head>
  <body class="bg-stone-50 min-h-screen text-gray-800 font-sans">
    <slot />
  </body>
</html>
