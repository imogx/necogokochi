---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ねこごこち",
  description = "猫を触る前に、その子の気持ちを予習できるインタラクティブサイト",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://imurar.github.io/necogokochi/favicon.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="https://imurar.github.io/necogokochi/favicon.png" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
  </head>
  <body
    class="bg-stone-50 min-h-screen text-gray-800"
    style="font-family: 'Noto Sans JP', sans-serif;"
  >
    <slot />
  </body>
</html>
