---
import Layout from "../layouts/Layout.astro";
import NecoInteractive from "../components/NecoInteractive";
---

<Layout>
  <main>
    <header class="text-center pt-10 pb-4 px-4">
      <h1>
        <img
          src={`${import.meta.env.BASE_URL}/title.png`.replace(/\/\//g, '/')}
          alt="ねこごこち"
          class="mx-auto w-64 max-w-full drop-shadow-sm"
        />
      </h1>
      <p class="mt-3 text-sm text-gray-400">
        猫を触る前に、その子の気持ちを<span class="font-semibold text-amber-600">予習</span>しよう
      </p>
    </header>

    <NecoInteractive
      client:load
      baseUrl={`${import.meta.env.BASE_URL}/`.replace(/\/\//g, '/')}
    />

    <footer class="text-center pb-8 text-xs text-gray-300">
      © 2026 ねこごこち
    </footer>
  </main>
</Layout>
